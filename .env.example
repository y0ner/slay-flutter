# Slay · variables de entorno (NO COMMITEAR el .env real)
# Copiá este archivo a .env y completá con tus valores:
#   cp .env.example .env

# URL de tu proyecto Supabase (Project Settings → API → Project URL)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# anon / publishable key (Project Settings → API → anon public)
# Esta key es pública pero es buena práctica no commitearla.
SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role key — SOLO para correr bin/migrate.dart una vez.
# NUNCA commitear el .env que contenga esta clave.
# (Project Settings → API → service_role secret)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Email del usuario "owner" al que se le asignan los datos durante la migración.
# OWNER_EMAIL=tu@email.com
